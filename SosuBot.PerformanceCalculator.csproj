<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>SosuBot.PerformanceCalculator</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Update="Calculators/Rosu/runtimes/**/native/*"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"
              Pack="true"
              PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" />
        <None Update="Calculators/Rosu/native/rosu-pp-native/README.md"
              Pack="true"
              PackagePath="README.md" />
    </ItemGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <ItemGroup>
		<PackageReference Include="OsuApi.Core" Version="0.1.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
		<PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.730.0" />
        <PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.730.0" />
        <PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.730.0" />
        <PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.730.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SosuBot.PerformanceCalculator.Tests" />
    </ItemGroup>

</Project>
